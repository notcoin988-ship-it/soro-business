# --- база ---
DATABASE_URL=postgresql+asyncpg://soro:soro@db:5432/soro
REDIS_URL=redis://redis:6379/0

# --- Soro LLM (уже развёрнут, адрес даст DevOps) ---
SORO_API_URL=https://soro.zehnlab.ai/v1
SORO_API_KEY=dev-key-change-me
SORO_MODEL=soro-27b-fp8
SORO_MAX_TOKENS=700
SORO_TEMPERATURE=0.2          # низкая: нам нужна точность, не креатив

# --- эмбеддинги (контейнер TEI поднимается в docker-compose) ---
EMBEDDINGS_URL=http://embeddings:80
EMBEDDINGS_DIM=1024           # у bge-m3 размерность 1024, НЕ менять

# --- RAG ---
RAG_TOP_K=12                  # сколько кандидатов достаём из БД
RAG_RETURN_K=3                # сколько фрагментов кладём в промпт
RAG_MIN_SCORE=0.60            # порог: ниже - считаем, что ответа нет

# --- каналы ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_WEBHOOK_SECRET=random-string-32-chars
TELEGRAM_BOT_USERNAME=EskhataDemoBot   # без @: из него собирается ссылка склейки
WHATSAPP_TOKEN=EAAG...        # временный токен из Meta for Developers
WHATSAPP_PHONE_ID=1055...     # id тестового номера
WHATSAPP_VERIFY_TOKEN=my-verify-token

# --- прочее ---
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app   # свой ngrok-адрес
CONSOLE_LOGIN=admin
CONSOLE_PASSWORD=поменять-обязательно
WORKSPACE_DEFAULT_SLUG=eskhata-demo

# --- откуда пускать консоль ---
# Нужен, только если фронт выложен отдельно (GitHub Pages), а бэкенд за
# туннелем: без этого браузер заблокирует запросы с чужого домена.
CORS_ORIGINS=https://notcoin988-ship-it.github.io
