# секреты — правило 10.1: любой секрет в git это инцидент
.env
*.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node
node_modules/
dist/
.vite/

# данные и загрузки
/data/
uploads/

# ide / os
.idea/
.vscode/
.DS_Store
Thumbs.db

# локальные настройки машины разработчика (см. report.md, п. 22)
docker-compose.override.yml

# черновики в корне проекта. Повод: test.py с боевым ключом Soro в
# открытом виде чуть не уехал в историю через git add -A. Правило 10.1:
# любой секрет в git — инцидент, дешевле не пускать такие файлы вовсе.
/test.py
/scratch*.py
/tmp*.py
